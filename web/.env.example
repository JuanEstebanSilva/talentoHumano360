# ─────────────────────────────────────────────────────────────────────────────
# Talento 360 — Plantilla de Variables de Entorno Seguras
# Copia este archivo como .env y completa con valores robustos generados aleatoriamente:
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# PostgreSQL (En producción: usar contraseña de al menos 16 caracteres alfanuméricos)
POSTGRES_DB=talento360
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_ROBUSTO_EN_PRODUCCION

# Enlace de puertos de PostgreSQL (Docker Compose usa POSTGRES_PORT; ejemplo local 5434)
POSTGRES_PORT=5434
POSTGRES_PORT_BINDING=127.0.0.1:5434:5432

# En nube (Neon PostgreSQL):
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@EP-POOLER.REGION.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://USUARIO:CONTRASENA@EP-DIRECT.REGION.aws.neon.tech/neondb?sslmode=require

# Protección de Base de Datos en arranque/despliegue (SIEMPRE false en producción)
AUTO_INIT_DB=false
# Solo habilitar temporalmente en una base completamente vacía durante la primera instalación
ALLOW_INITIAL_DB_BOOTSTRAP=false

# JSON Web Token (JWT) — Generar con: openssl rand -hex 32
JWT_SECRET=GENERAR_SECRETO_CRIPTOGRAFICO_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRES_IN=2h

# CORS — Lista de orígenes permitidos separados por comas (en producción usar URL exacta de Vercel)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80
# Opcional: permitir despliegues Preview de Vercel (*.vercel.app) en entorno de pruebas
ALLOW_VERCEL_PREVIEWS=false

# Seguridad de Cookies (true en producción con HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ─────────────────────────────────────────────────────────────────────────────
# Servicio de Notificaciones por Correo (SMTP)
# ─────────────────────────────────────────────────────────────────────────────
# Habilitar o deshabilitar envíos (true para enviar, false para modo simulado)
MAIL_ENABLED=true

# Servidor SMTP (Ejemplos:
#   Gmail:           smtp.gmail.com (puerto 587 o 465)
#   Microsoft 365:   smtp.office365.com (puerto 587)
#   Mailtrap / Dev:  sandbox.smtp.mailtrap.io (puerto 2525)
# )
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Credenciales de autenticación SMTP
# Para Gmail: usa una "Contraseña de aplicación" de 16 letras generada en tu cuenta Google
# Para Microsoft 365: buzón institucional con permiso SMTP AUTH
SMTP_USER=
SMTP_PASS=

# Remitente visible (Opcional, por defecto toma SMTP_USER)
# Ejemplo: "Talento Humano 360 <no-reply@boyaca.gov.co>"
MAIL_FROM=

# Opcional para pruebas: Si defines un correo aquí, TODOS los correos
# (del jefe y del solicitante) se desviarán a esta dirección para que verifiques.
MAIL_REDIRECT_TO=

# Opcional: poner en false si tu servidor SMTP usa certificados autofirmados
SMTP_TLS_REJECT_UNAUTHORIZED=true

# URL pública del frontend para enlaces de recuperación y notificaciones en correos
APP_PUBLIC_URL=http://localhost
APP_URL=http://localhost
# URL pública del backend para enlaces directos de aprobación desde correos (en nube usar URL de Render)
BACKEND_PUBLIC_URL=http://localhost
